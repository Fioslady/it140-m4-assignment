# IT 140 Module Four Assignment
START

OUTPUT "Enter the lower bound:"
INPUT lower_bound

OUTPUT "Enter the upper bound:"
INPUT upper_bound

WHILE lower_bound >= upper_bound
    OUTPUT "Invalid bounds. The lower bound must be less than the upper bound."

    OUTPUT "Enter the lower bound:"
    INPUT lower_bound

    OUTPUT "Enter the upper bound:"
    INPUT upper_bound
END WHILE

LET secret_number = RANDOM NUMBER BETWEEN lower_bound AND upper_bound

OUTPUT "Enter a guess between " + lower_bound + " and " + upper_bound + ":"
INPUT user_guess

WHILE user_guess < lower_bound OR user_guess > upper_bound
    OUTPUT "Invalid guess. Please enter a number within the range."

    OUTPUT "Enter a guess between " + lower_bound + " and " + upper_bound + ":"
    INPUT user_guess
END WHILE

WHILE user_guess != secret_number

    IF user_guess < secret_number THEN
        OUTPUT "Too low."
    ELSE
        OUTPUT "Too high."
    END IF

    OUTPUT "Enter a guess between " + lower_bound + " and " + upper_bound + ":"
    INPUT user_guess

    WHILE user_guess < lower_bound OR user_guess > upper_bound
        OUTPUT "Invalid guess. Please enter a number within the range."

        OUTPUT "Enter a guess between " + lower_bound + " and " + upper_bound + ":"
        INPUT user_guess
    END WHILE

END WHILE

OUTPUT "Correct! You guessed the number."

END
    
# === References ===
# Gaddis, T. (2021). Starting out with Python (5th ed.). Pearson.
# Python Software Foundation. (2026). The Python tutorial: Control flow tools. [docs.python.org](https://docs.python.org/3/tutorial/controlflow.html)
# zyBooks. (2026). IT 140: Introduction to scripting. zyBooks.
